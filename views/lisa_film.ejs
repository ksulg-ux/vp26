<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Kaisa Sulg, veebiprogrammeerimine</title>
</head>
<body>
	<img src="../pic/veebiprogrammeerimine_2026_AA.png" alt="banner">
	<h1>Eesti film</h1>
	<p>Siin saab lisada Eesti filme.</p>
	<ul>
		<li><a href="/">Avalehele</a></li>
		<li><a href="/eestifilm">Eesti filmi avalehele</a></li>
	</ul>
	<hr>
	<h2>Lisa film</h2>

	<form method="POST">

    <label for="titleInput">Filmi pealkiri</label>
    <input id="titleInput" name="titleInput" type="text" placeholder="Pealkiri" value="<%= title %>">

    <br>

    <label for="releaseYearInput">Väljalaskeaasta</label>
    <input id="releaseYearInput" name="releaseYearInput" type="number" placeholder="0" value="<%= releaseYear %>">

    <br>

    <label for="durationInput">Kestus minutites</label>
    <input id="durationInput" name="durationInput" type="number" placeholder="0" value="<%= duration %>">

    <br>

    <label for="descriptionInput">Kirjeldus</label>
    <textarea id="descriptionInput" name="descriptionInput" placeholder="Kirjeldus"><%= description %></textarea>

    <br>

    <input type="submit" value="Salvesta">

</form>

<p><%= notice %></p>