<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Kaisa Sulg, veebiprogrammeerimine</title>
</head>

 <style>
        .gallery {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .photo {
            width: 300px;
        }

        .photo img {
            width: 300px;
            height: 220px;
            object-fit: cover;
            border-radius: 10px;
            display: block;
        }

        .caption {
            margin-top: 5px;
            text-align: center;
        }
    </style>
</head>

<body>
    <img src="/pic/veebiprogrammeerimine_2026_AA.png" alt="banner">

    <h1>Kaisa Sulg, veebiprogrammeerimine</h1>

    <p>
        <a href="/home">Tagasi avalehele</a>
		<li><a href="/logout">Logi välja</a></li>
    </p>

    <p>
        <a href="/galleryphotoupload">Fotode üleslaadimine galeriisse</a>
    </p>

    <hr>

    <h2>Pildigalerii</h2>

    <div class="gallery">

        <% photos.forEach(photo => { %>

            <div class="photo">

                <img
                    src="/gallery/normal/<%= photo.filename %>"
                    alt="<%= photo.alttext || 'Foto' %>">

                <div class="caption">
                    <%= photo.alttext || 'Foto' %>
                </div>

            </div>

        <% }) %>

    </div>

</body>
</html>